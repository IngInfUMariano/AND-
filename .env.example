# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=inventa_db
DB_SYNC=false

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
JWT_EXPIRES_IN_TIENDA=30d

# ── Stripe (modo sandbox — no procesa fondos reales) ──────────────────────────
# Obtén estas llaves en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Llave pública para el frontend (la que usa Stripe Elements)
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secreto del webhook: generado con `stripe listen --forward-to localhost:3000/api/pagos/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
# Moneda (código ISO 4217 en mayúsculas). GTQ = Quetzal guatemalteco
STRIPE_CURRENCY=GTQ

# ── Email (opcional) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
