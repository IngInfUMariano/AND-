# =============================================================================
# BLOQUE 1 — Login
# =============================================================================

### 1. Login interno exitoso (admin)
POST {{base}}/auth/interno
Content-Type: application/json

{
  "email": "admin@inventa.gt",
  "password": "Admin123!"
}

### 2. Login interno exitoso (bodeguero)
POST {{base}}/auth/interno
Content-Type: application/json

{
  "email": "bodega@inventa.gt",
  "password": "Bodega123!"
}

### 3. Login tienda exitoso (cliente minorista)
POST {{base}}/auth/tienda
Content-Type: application/json

{
  "email": "ana.morales@gmail.com",
  "password": "Cliente123!"
}

### 4. Login con contraseña incorrecta → 401
POST {{base}}/auth/interno
Content-Type: application/json

{
  "email": "admin@inventa.gt",
  "password": "wrongpassword"
}

### 5. Login con email inexistente → 401
POST {{base}}/auth/interno
Content-Type: application/json

{
  "email": "noexiste@inventa.gt",
  "password": "Admin123!"
}

### 6. Cliente intentando entrar por /interno → 401
POST {{base}}/auth/interno
Content-Type: application/json

{
  "email": "ana.morales@gmail.com",
  "password": "Cliente123!"
}

### 7. Empleado intentando entrar por /tienda → 401
POST {{base}}/auth/tienda
Content-Type: application/json

{
  "email": "admin@inventa.gt",
  "password": "Admin123!"
}

# =============================================================================
# BLOQUE 2 — Rutas protegidas
# =============================================================================

### 8. Ver perfil con token válido (admin)
GET {{base}}/auth/perfil
Authorization: Bearer {{token_admin}}

### 9. Ver perfil sin token → 401
GET {{base}}/auth/perfil

### 10. Ver perfil con token inventado → 401
GET {{base}}/auth/perfil
Authorization: Bearer token.inventado.invalido

# =============================================================================
# BLOQUE 3 — Registro
# =============================================================================

### 11. Registro de cliente nuevo
POST {{base}}/auth/registro
Content-Type: application/json

{
  "nombre": "Pedro García",
  "email": "pedro.garcia@gmail.com",
  "password": "Pedro123!",
  "telefono": "55667788"
}

### 12. Registro con email ya existente → error
POST {{base}}/auth/registro
Content-Type: application/json

{
  "nombre": "Pedro García",
  "email": "pedro.garcia@gmail.com",
  "password": "Pedro123!",
  "telefono": "55667788"
}

# =============================================================================
# BLOQUE 4 — Contraseña
# =============================================================================

### 13. Cambiar contraseña estando logueado
PUT {{base}}/auth/password
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "password_actual": "Admin123!",
  "password_nuevo": "Admin456!"
}

### 14. Solicitar recuperación de contraseña
POST {{base}}/auth/recuperar
Content-Type: application/json

{
  "email": "admin@inventa.gt"
}
